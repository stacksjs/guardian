  .architecture-branches::before { content: ''; position: absolute; left: 50%; bottom: 100%; height: 24px; border-left: 1px solid var(--connector); }
  .architecture-branches::after { content: ''; position: absolute; inset: 0; height: 22px; border-left: 1px solid var(--connector); border-right: 1px solid var(--connector); }
  .engine-node { position: relative; background: var(--canvas); border: 1px solid var(--border); }
  .engine-node:nth-child(2)::before { content: ''; position: absolute; left: 50%; bottom: 100%; height: 22px; border-left: 1px solid var(--connector); }
  .workspace-panel { background: var(--surface); border: 1px solid var(--border); }
  .desktop-panel { background: var(--accent-soft); border: 1px solid var(--border); }
  .symbol-tile { flex-shrink: 0; background: var(--canvas); color: var(--muted); border: 1px solid var(--border); }
  .connection-rule { height: 1px; max-width: 42px; flex: 1; background: var(--connector); }
  .desktop-symbol { background: var(--canvas); color: var(--accent); border: 1px solid var(--border); }
  .engine-row { border-bottom: 1px solid var(--border); transition: background 160ms ease; }
  .engine-row:hover { background: var(--surface); }
  .engine-icon { color: var(--accent); background: var(--accent-soft); }
  .development-panel { background: var(--surface); border: 1px solid var(--border); }
  @media (prefers-reduced-motion: reduce) {
    .button-primary, .button-secondary, .engine-row { transition: none; }

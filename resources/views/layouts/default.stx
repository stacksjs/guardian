<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>
  <body class="min-h-[100dvh] antialiased">
    <a href="#main" class="sr-only focus:not-sr-only skip-link">Skip to content</a>
    <header class="flex gap-6 items-center justify-between mx-auto px-5 md:px-8 h-20 max-w-6xl">
      <a href="/" aria-label="Guardian home" class="flex gap-2.5 items-center font-semibold text-xl tracking-tight brand">
        <span aria-hidden="true" class="inline-flex items-center justify-center h-8 w-8 rounded-lg brand-mark"><i class="h-5 w-5 i-hugeicons-security-check"></i></span>
        Guardian
      </a>
      <nav aria-label="Main navigation" class="flex gap-5 items-center md:gap-8 text-sm">
        <a class="hidden sm:inline-flex nav-link" href="#overview">Overview</a>
        <a class="nav-link" href="#engines">Engines</a>
        <a class="nav-link" href="#development">Roadmap</a>
        <a href="https://github.com/stacksjs/guardian" aria-label="View Guardian on GitHub" class="hidden sm:inline-flex items-center justify-center h-9 w-9 rounded-md source-link"><i aria-hidden="true" class="h-5 w-5 i-hugeicons-github"></i></a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      @yield('content')
    </main>
    <footer class="flex flex-col gap-5 justify-between md:flex-row md:items-center mx-auto px-5 py-8 md:px-8 max-w-6xl text-sm section-border">
      <span class="font-semibold tracking-tight">Guardian</span>
      <p class="text-[var(--muted)]">Open source security tooling, built with <a class="text-link" href="https://stacksjs.com">Stacks</a>.</p>
    </footer>
    @stack('scripts')
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --canvas: #fdfdfc;
    --surface: #f6f7f5;
    --diagram: #eff3ef;
    --text: #202622;
    --muted: #68716b;
    --border: #e5e8e3;
    --connector: #c9d3c9;
    --accent: #396447;
    --accent-soft: #eaf0e8;
    --button: #243c2c;
    --button-text: #f8faf7;
  }
  .brand-mark, .hub-mark { background: var(--accent-soft); color: var(--accent); }
  .nav-link { color: var(--muted); transition: color 160ms ease; }
  .nav-link:hover, .text-link:hover { color: var(--text); }
  .source-link { border: 1px solid var(--border); }
  .source-link:hover { background: var(--surface); }
  .section-border { border-top: 1px solid var(--border); }
  .text-link { text-decoration: underline; text-underline-offset: 3px; }
  html { scroll-behavior: smooth; scroll-padding-top: 24px; }
  body { margin: 0; background: var(--canvas); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif; }
  a { color: inherit; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  ::selection { background: var(--accent-soft); color: var(--text); }
  .skip-link:focus { position: fixed; left: 16px; top: 16px; z-index: 1; padding: 12px 18px; background: var(--canvas); color: var(--text); border: 1px solid var(--border); border-radius: 6px; }
  @media (prefers-color-scheme: dark) {
    :root {
      --canvas: #171c19;
      --surface: #1e2520;
      --diagram: #202c23;
      --text: #e9eee7;
      --muted: #a4afa5;
      --border: #343e35;
      --connector: #4c5c4e;
      --accent: #abc5a7;
      --accent-soft: #2b3b2b;
      --button: #d9e7d4;
      --button-text: #203023;
    }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .nav-link { transition: none; } }
</style>
